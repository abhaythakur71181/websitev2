# ── Site ────────────────────────────────────────────────────────────────
# Canonical URL (no trailing slash). Used for metadata, sitemap, RSS, OG.
NEXT_PUBLIC_SITE_URL=https://abhaythakur71181.vercel.app

# ── GitHub data (optional, recommended) ─────────────────────────────────
# Fine-grained PAT with public repo read access. Raises API rate limits and
# enables the exact contribution calendar via GraphQL. Works without it.
GITHUB_TOKEN=

# ── Database (optional — powers guestbook, comments, reactions, views) ──
# Neon/Postgres connection string. Run `npx drizzle-kit push` once to create
# tables. Without it, all social features hide themselves gracefully.
DATABASE_URL=

# ── SSO / Auth.js (optional — needed for guestbook + comments + reactions)
# Generate AUTH_SECRET with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# GitHub OAuth app → callback URL: {SITE_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client → callback URL: {SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── AI assistant (optional — "ask about me" on /about) ──────────────────
# Set ONE of these. Anthropic is preferred if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override (defaults: claude-haiku-4-5 / gpt-4o-mini)
AI_MODEL=

# ── Analytics (optional) ────────────────────────────────────────────────
# Your GoatCounter code, e.g. "abhaythakur71181" for abhaythakur71181.goatcounter.com
NEXT_PUBLIC_GOATCOUNTER_CODE=
